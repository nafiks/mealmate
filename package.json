{
  "name": "mealmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MealMate — find a recipe from what you already have at home",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed:reset": "node server/seed.js --reset",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
